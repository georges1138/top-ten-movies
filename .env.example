# TMDB API v3 key
TMDB_API_KEY=

# Flask session signing secret
SECRET_KEY=

# Flask debug mode (disabled by default)
FLASK_DEBUG=0

# FastAPI application settings
# TMDB v4 API Read Access Token, sent as a Bearer header.
TMDB_READ_TOKEN=

# FastAPI debug mode (disabled by default).
DEBUG=false

# Password used by the local PostgreSQL Docker container.
# Use the same password in DATABASE_URL below.
POSTGRES_PASSWORD=

# PostgreSQL connection URL for the FastAPI application.
# Replace these example credentials with your local database credentials.
DATABASE_URL=postgresql+psycopg://movie_user:change-me@localhost:5432/movies
